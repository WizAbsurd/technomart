var buylink = document.querySelectorAll(".buy");
var pricelink = document.querySelector(".price");
var catalogpopup = document.querySelector(".modal-catalog");
var closecat = document.querySelector(".modal-catalog-close");
var continuecat = document.querySelector(".modal-catalog-button");

pricelink.addEventListener("click", function (evt) {
  evt.preventDefault();
  catalogpopup.classList.add("modal-show");
  console.log("работаем братья 3");
});
closecat.addEventListener("click", function (evt) {
  evt.preventDefault();
  catalogpopup.classList.remove("modal-show");
  console.log("не работаем братья 3");
});
